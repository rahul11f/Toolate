generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id               String           @id @default(cuid())
  name             String?
  email            String?          @unique
  emailVerified    DateTime?
  image            String?
  passwordHash     String?
  role             String           @default("USER")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  lifestyleProfile String?
  documentStatus   String           @default("UNVERIFIED")
  documentVerified Boolean          @default(false)
  documentNumber   String?
  documentType     String?
  documentUrl      String?
  legalName        String?
  accounts         Account[]
  adminLogs        AdminLog[]
  areaReviews      AreaReview[]
  listings         Listing[]
  questionsAsked   ListingQA[]
  notifications    Notification[]
  rentPayments     RentPayment[]
  reviews          Review[]
  sessions         Session[]
  viewingBookings  ViewingBooking[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id         String   @id @default(cuid())
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Listing {
  id                   String           @id @default(cuid())
  title                String
  description          String
  category             String
  price                Float
  openingHours         String
  closingHours         String
  landlordTerms        String
  contactNumber        String
  whatsappNumber       String
  address              String
  lat                  Float
  lng                  Float
  area                 String
  state                String           @default("")
  city                 String           @default("")
  roommateType         String?
  roommateGender       String?
  facilities           String           @default("{}")
  images               String
  featured             Boolean          @default(false)
  status               String           @default("PENDING")
  userId               String
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  aiFraudFlags         String?
  aiFraudScore         Int?
  expiresAt            DateTime?
  foodType             String?
  priceType            String?
  requireVerification  Boolean          @default(false)
  checkInDate          DateTime?
  checkOutDate         DateTime?
  hotelBookingProofUrl String?
  hotelBookingRef      String?
  hotelName            String?
  hotelSplitStatus     String           @default("AVAILABLE")
  hotelSplitUserId     String?
  isSharedHotelRoom    Boolean          @default(false)
  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  events               ListingEvent[]
  questions            ListingQA[]
  rentPayments         RentPayment[]
  reviews              Review[]
  viewingBookings      ViewingBooking[]
  viewingSlots         ViewingSlot[]

  @@index([userId])
  @@index([status])
  @@index([category, city])
}

model AdminLog {
  id         String   @id @default(cuid())
  adminId    String
  action     String
  targetType String
  targetId   String
  details    String?
  timestamp  DateTime @default(now())
  admin      User     @relation(fields: [adminId], references: [id], onDelete: Cascade)
}

model SiteSettings {
  id              String   @id @default("default")
  heroTitle       String   @default("Find Your Next Home, Flat or Shop Without Brokerage")
  heroSubtitle    String   @default("Search vetted listings for houses, flats, PGs, and commercial spaces. Open coordinates, direct landlord contacts, zero fees.")
  footerText      String   @default("Toolate Inc. All rights reserved. Built completely on Free Tier APIs.")
  metaTitle       String   @default("Toolate - House, Flat, PG & Shop Listings")
  metaDescription String   @default("Completely free-to-use directory listing for rental and sale properties including houses, flats, shared PGs, and commercial shops.")
  adsenseId       String   @default("")
  maintenanceMode Boolean  @default(false)
  updatedAt       DateTime @updatedAt
  helpEmail       String   @default("support@toolate.com")
  officeAddress   String   @default("Prestige Tech Park, Outer Ring Rd, Bangalore, KA, India")
  supportEmail    String   @default("info@toolate.com")
  supportPhone    String   @default("+91 80 4455 6677")
  whatsappSupport String   @default("+91 80 4455 6677")
}

model Review {
  id             String   @id @default(cuid())
  rating         Int
  comment        String
  listingId      String
  userId         String
  createdAt      DateTime @default(now())
  depositReturn  Int?
  honesty        Int?
  maintenance    Int?
  responsiveness Int?
  verifiedTenant Boolean  @default(false)
  listing        Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Feedback {
  id        String    @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  reply     String?
  repliedAt DateTime?
  createdAt DateTime  @default(now())
}

model ViewingSlot {
  id        String           @id @default(cuid())
  listingId String
  dayOfWeek Int
  startTime String
  endTime   String
  bookings  ViewingBooking[]
  listing   Listing          @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model ViewingBooking {
  id        String      @id @default(cuid())
  slotId    String
  listingId String
  tenantId  String
  date      DateTime
  message   String?
  status    String      @default("PENDING")
  createdAt DateTime    @default(now())
  listing   Listing     @relation(fields: [listingId], references: [id], onDelete: Cascade)
  slot      ViewingSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  tenant    User        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model ListingEvent {
  id        String   @id @default(cuid())
  listingId String
  eventType String
  userAgent String?
  city      String?
  createdAt DateTime @default(now())
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, eventType])
  @@index([createdAt])
}

model AreaReview {
  id                String   @id @default(cuid())
  city              String
  area              String
  userId            String
  safety            Int
  waterSupply       String
  powerCuts         String
  transport         String
  market            String
  noise             String
  internetProviders String?
  comment           String?
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, city, area])
}

model ListingQA {
  id         String    @id @default(cuid())
  listingId  String
  askedBy    String
  question   String
  answer     String?
  answeredAt DateTime?
  upvotes    Int       @default(0)
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [askedBy], references: [id], onDelete: Cascade)
  listing    Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model RentPayment {
  id                String   @id @default(cuid())
  tenantUserId      String
  listingId         String
  month             Int
  year              Int
  amountPaid        Float
  upiScreenshotUrl  String?
  landlordConfirmed Boolean  @default(false)
  createdAt         DateTime @default(now())
  listing           Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  tenant            User     @relation(fields: [tenantUserId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime

  @@unique([email, token])
}
