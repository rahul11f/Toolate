generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String?    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          String     @default("USER")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  accounts      Account[]
  adminLogs     AdminLog[]
  listings      Listing[]
  reviews       Review[]
  sessions      Session[]
  viewingBookings ViewingBooking[]
  lifestyleProfile String?
  areaReviews      AreaReview[]
  questionsAsked   ListingQA[]
  rentPayments     RentPayment[]
  documentVerified Boolean   @default(false)
  documentStatus   String    @default("UNVERIFIED")
  documentType     String?
  legalName        String?
  documentNumber   String?
  documentUrl      String?
  notifications    Notification[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id         String   @id @default(cuid())
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Listing {
  id             String    @id @default(cuid())
  title          String
  description    String
  category       String
  price          Float
  openingHours   String
  closingHours   String
  landlordTerms  String
  contactNumber  String
  whatsappNumber String
  address        String
  lat            Float
  lng            Float
  area           String
  state          String    @default("")
  city           String    @default("")
  roommateType   String?
  roommateGender String?
  facilities     String    @default("{}")
  images         String
  featured       Boolean   @default(false)
  status         String    @default("PENDING")
  foodType       String?   // VEG_ONLY | NON_VEG | JAIN | NO_MEALS (for PG/Hostel)
  aiFraudScore   Int?      // 0-100 fraud confidence score
  aiFraudFlags   String?   // JSON array of fraud flags
  expiresAt      DateTime? // Auto-expiry date
  priceType      String?   // FREE | PAID | OTHER
  requireVerification Boolean @default(false)
  isSharedHotelRoom   Boolean   @default(false)
  hotelName           String?
  hotelBookingRef     String?
  checkInDate         DateTime?
  checkOutDate        DateTime?
  hotelBookingProofUrl String?
  hotelSplitStatus    String    @default("AVAILABLE") // AVAILABLE | REQUESTED | COMPLETED
  hotelSplitUserId    String?
  userId         String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviews        Review[]
  viewingSlots    ViewingSlot[]
  viewingBookings ViewingBooking[]
  events          ListingEvent[]
  questions       ListingQA[]
  rentPayments    RentPayment[]

  @@index([userId])
  @@index([status])
  @@index([category, city])
}

model AdminLog {
  id         String   @id @default(cuid())
  adminId    String
  action     String
  targetType String
  targetId   String
  details    String?
  timestamp  DateTime @default(now())
  admin      User     @relation(fields: [adminId], references: [id], onDelete: Cascade)
}

model SiteSettings {
  id              String   @id @default("default")
  heroTitle       String   @default("Find Your Next Home, Flat or Shop Without Brokerage")
  heroSubtitle    String   @default("Search vetted listings for houses, flats, PGs, and commercial spaces. Open coordinates, direct landlord contacts, zero fees.")
  footerText      String   @default("Toolate Inc. All rights reserved. Built completely on Free Tier APIs.")
  metaTitle       String   @default("Toolate - House, Flat, PG & Shop Listings")
  metaDescription String   @default("Completely free-to-use directory listing for rental and sale properties including houses, flats, shared PGs, and commercial shops.")
  adsenseId       String   @default("")
  maintenanceMode Boolean  @default(false)
  helpEmail       String   @default("support@toolate.com")
  supportEmail    String   @default("info@toolate.com")
  officeAddress   String   @default("Prestige Tech Park, Outer Ring Rd, Bangalore, KA, India")
  supportPhone    String   @default("+91 80 4455 6677")
  whatsappSupport String   @default("+91 80 4455 6677")
  updatedAt       DateTime @updatedAt
}

model Review {
  id              String   @id @default(cuid())
  rating          Int
  comment         String
  listingId       String
  userId          String
  responsiveness  Int?     // 1-5 rating
  honesty         Int?     // 1-5 rating
  maintenance     Int?     // 1-5 rating
  depositReturn   Int?     // 1-5 rating
  verifiedTenant  Boolean  @default(false)
  createdAt       DateTime @default(now())
  listing         Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Feedback {
  id        String    @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  reply     String?
  repliedAt DateTime?
  createdAt DateTime  @default(now())
}

model ViewingSlot {
  id         String   @id @default(cuid())
  listingId  String
  dayOfWeek  Int      // 0=Sun, 6=Sat
  startTime  String   // "10:00"
  endTime    String   // "12:00"
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  bookings   ViewingBooking[]
}

model ViewingBooking {
  id        String   @id @default(cuid())
  slotId    String
  listingId String
  tenantId  String
  date      DateTime
  message   String?
  status    String   @default("PENDING") // PENDING | CONFIRMED | CANCELLED
  createdAt DateTime @default(now())
  slot      ViewingSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  listing   Listing     @relation(fields: [listingId], references: [id], onDelete: Cascade)
  tenant    User        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model ListingEvent {
  id        String   @id @default(cuid())
  listingId String
  eventType String   // VIEW | INQUIRY | SAVE | SHARE
  userAgent String?
  city      String?
  createdAt DateTime @default(now())
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, eventType])
  @@index([createdAt])
}

model AreaReview {
  id                String   @id @default(cuid())
  city              String
  area              String
  userId            String
  safety            Int      // 1-5
  waterSupply       String   // 24_7 | TANKER | LIMITED
  powerCuts         String   // RARE | OCCASIONAL | FREQUENT
  transport         String   // EXCELLENT | GOOD | POOR
  market            String   // WALKING | 10_MIN | FAR
  noise             String   // QUIET | MODERATE | LOUD
  internetProviders String?  // JSON array
  comment           String?
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, city, area])
}

model ListingQA {
  id         String    @id @default(cuid())
  listingId  String
  askedBy    String
  question   String
  answer     String?
  answeredAt DateTime?
  upvotes    Int       @default(0)
  createdAt  DateTime  @default(now())
  listing    Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [askedBy], references: [id], onDelete: Cascade)
}

model RentPayment {
  id                 String   @id @default(cuid())
  tenantUserId       String
  listingId          String
  month              Int
  year               Int
  amountPaid         Float
  upiScreenshotUrl   String?
  landlordConfirmed  Boolean  @default(false)
  createdAt          DateTime @default(now())
  tenant             User     @relation(fields: [tenantUserId], references: [id], onDelete: Cascade)
  listing            Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
